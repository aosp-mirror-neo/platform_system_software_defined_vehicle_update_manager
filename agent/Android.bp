package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "sdv_update_manager_agent@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    crate_name: "sdv_update_manager_agent",
    rustlibs: [
        "apex_aidl_interface-rust",
        "android.hardware.boot-V1-rust",
        "google.sdv.vpm-V1-rust",
        "libapkverify",
        "libbinder_rs",
        "libbinder_tokio_rs",
        "libcom_android_sdv_update_manager_client_update_manager_listener_service_rpc_rs",
        "libcom_android_sdv_update_manager_update_manager_service_rpc_rs",
        "libfutures",
        "liblogger",
        "liblog_rust",
        "libmockall",
        "libpersistent_binder",
        "libprotobuf",
        "librand",
        "librustutils",
        "libsdv_log_rust",
        "libsdv_status_rs",
        "libsdv_comms_ctx_impl",
        "libsdv_comms_rs",
        "libsdv_mw_rs_comms",
        "libsdv_mw_rs_sdv_comms",
        "libsdv_mw_rs_com_android_sdv_update_manager_update_manager_agent",
        "libtokio",
        "libtokio_stream",
        "libupdate_engine_aidl_interface-rust",
        "libupdate_manager_api",
        "libzip",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_binary {
    name: "sdv_update_manager_agent",
    apex_available: [
        "//apex_available:platform",
    ],
    defaults: [
        "sdv_update_manager_agent@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    prefer_rlib: true,
    system_ext_specific: true,
}

rust_test {
    name: "sdv_update_manager_agent_unit_tests",
    defaults: [
        "sdv_update_manager_agent@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libgoogletest_rust",
        "libtempfile",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    data: ["test_data/*"],
}
